# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini (AI)
GEMINI_API_KEY=

# Google Places API (New) + Geocoding API.
# Server-side only. Create this key in the same Google Cloud project,
# enable billing, restrict APIs to Places API (New) and Geocoding API,
# and restrict the key by the Render server egress IP when available.
GOOGLE_PLACES_API_KEY=

# Optional: only when frontend and backend are on different origins.
VITE_API_URL=
