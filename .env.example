# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini (AI)
GEMINI_API_KEY=

# Google Custom Search JSON API — única integração usada para busca web/localização
# GOOGLE_SEARCH_API_KEY: API key criada no Google Cloud Console.
# GOOGLE_SEARCH_CX: Search Engine ID (CX) criado no Programmable Search Engine.
# Mantenha os dois valores somente no servidor/Render; nunca use VITE_ para essas credenciais.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Opcional: somente quando frontend e backend estiverem em origens diferentes.
VITE_API_URL=
