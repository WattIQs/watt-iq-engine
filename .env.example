# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini (AI)
GEMINI_API_KEY=

# Google Custom Search JSON API (server-side location lookup / web search)
# Create the API key in Google Cloud Console and obtain the Search Engine ID (CX)
# from Programmable Search Engine. Keep both values server-side.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Optional: only when frontend and backend are on different origins.
VITE_API_URL=
