# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Gemini (AI)
GEMINI_API_KEY=

# Geoapify geocoding + address autocomplete.
# Create a free project/key at https://myprojects.geoapify.com/.
# The free plan currently provides 3,000 credits/day without a credit card;
# check Geoapify's current commercial-use terms before production scale.
# Keep this key server-side; do not expose it through VITE_* variables.
GEOAPIFY_API_KEY=

# Optional: only when frontend and backend are on different origins.
VITE_API_URL=
